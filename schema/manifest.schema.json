{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dbunk evidence-bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "source",
          "captured_at"
        ],
        "properties": {
          "path": {
            "$ref": "defs.schema.json#/$defs/relative_path"
          },
          "sha256": {
            "$ref": "defs.schema.json#/$defs/sha256"
          },
          "source": {
            "$ref": "defs.schema.json#/$defs/text",
            "description": "Where the file came from: a URL, a command, a system or a person."
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 date-time when the file was captured."
          }
        }
      }
    }
  }
}

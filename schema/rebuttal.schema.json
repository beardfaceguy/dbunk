{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dbunk Rebuttal",
  "description": "The v1.3 Rebuttal plus dbunk extension fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "round",
    "position",
    "blocking_responses",
    "requesting",
    "packet_digest"
  ],
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "position": {
      "enum": [
        "AGREE",
        "DISAGREE",
        "PARTIAL"
      ]
    },
    "blocking_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concern_id",
          "disposition",
          "reason"
        ],
        "properties": {
          "concern_id": {
            "type": "string",
            "pattern": "^B[1-9][0-9]*$"
          },
          "disposition": {
            "enum": [
              "ACCEPT",
              "DISPUTE",
              "CLARIFY"
            ]
          },
          "reason": {
            "$ref": "defs.schema.json#/$defs/text"
          }
        }
      },
      "minItems": 1
    },
    "new_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[1-9][0-9]*$"
          },
          "text": {
            "$ref": "defs.schema.json#/$defs/text"
          }
        }
      }
    },
    "requesting": {
      "enum": [
        "RE-REVIEW",
        "WITHDRAWN",
        "FINAL-POSITION"
      ]
    },
    "packet_digest": {
      "$ref": "defs.schema.json#/$defs/sha256",
      "description": "dbunk extension: the packet digest after this rebuttal. Equal to the previous digest when the packet is unchanged."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "round": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "requesting": {
            "not": {
              "const": "RE-REVIEW"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "round": {
            "maximum": 2
          }
        }
      },
      "then": {
        "properties": {
          "requesting": {
            "not": {
              "const": "FINAL-POSITION"
            }
          }
        }
      }
    }
  ]
}
